# ==============================================================================
# Cast CLI .gitignore
# ==============================================================================

# --- Dependencies & Package Managers ---
node_modules/
.npm/
.bun/
*.lockb

# --- Build Outputs & Compilations ---
dist/
build/
out/
bin/
*.tsbuildinfo

# --- Environment & Secret Vaults (CRITICAL) ---
.env
.env.*
!.env.example
*.enc
credentials.enc
.cast/
.credentials/

# --- Local SQLite Databases & Data Files ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
cast.db

# --- Logs & Runtime Artifacts ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
tmp/
temp/
scratch/
.temp/

# --- Testing & Coverage ---
coverage/
.nyc_output/
*.lcov

# --- OS Specific Files ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# --- IDEs & Editors ---
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# --- Agent & Local AI Instructions ---
AGENTS.md
agents.md
CLAUDE.md
.claude/
.cursor/
.windsurf/
.codex/
.agents/
